# Neon connection string (pooled). Create a free Neon project, copy it here.
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Two random tokens. Generate with: openssl rand -hex 32
# WRITE_TOKEN goes in the Claude cloud environment (hooks). It can only post events.
# READ_TOKEN goes in the Android app. It can read status and register the device.
WRITE_TOKEN=
READ_TOKEN=

# Vercel sends this as "Authorization: Bearer <value>" to cron routes. Any random string.
CRON_SECRET=

# Firebase service account JSON (raw JSON or base64 of it). Needed for FCM push.
# Leave empty to run without push (clients fall back to fetching /api/status).
FCM_SERVICE_ACCOUNT_JSON=
