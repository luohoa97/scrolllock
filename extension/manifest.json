{
  "manifest_version": 3,
  "name": "ScrollLock",
  "version": "0.1.0",
  "description": "Blocks instagram.com on desktop unless Claude is working. Messages stay usable.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["gate.js", "route.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
