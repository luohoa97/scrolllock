# Set these in the environment your Claude Code sessions run in.
#   Cloud sessions / project threads: Project settings > Environment > environment variables.
#   Local Claude Code: export them in your shell (fish: set -Ux SCROLLLOCK_URL ...).
SCROLLLOCK_URL=https://your-relay.vercel.app
SCROLLLOCK_WRITE_TOKEN=
# Optional: log every hook call to $TMPDIR/scrolllock-hook.log
# SCROLLLOCK_DEBUG=1
